  "resources/views/auth.blade.php": "@extends('layouts.master')\n\n@section('title')\n  Login & Register\n@endsection\n@section('scripts')\n  <script src={{ asset(\"js/auth.js\") }}></script>\n@endsection\n@section('styles')\n  <script src={{ asset(\"css/auth.js\") }}></script>\n@endsection\n\n\n@section('body')\n  <main>\n    <!-- ===== بخش احراز هویت ===== -->\n    <section class=\"auth-section container\">\n      <div class=\"auth-card\">\n        <div class=\"auth-tabs\">\n          <button class=\"auth-tab active\" data-tab=\"login\">Login</button>\n          <button class=\"auth-tab\" data-tab=\"register\">Register</button>\n        </div>\n\n        <!-- فرم ورود -->\n        <form class=\"auth-form active\" id=\"loginForm\" novalidate>\n          <h2 class=\"auth-title\">Welcome Back</h2>\n          <div class=\"form-group\">\n            <label for=\"loginEmail\">Email</label>\n            <input type=\"email\" id=\"loginEmail\" placeholder=\"your@email.com\" required>\n            <span class=\"error-msg\" id=\"loginEmailError\"></span>\n          </div>\n          <div class=\"form-group\">\n            <label for=\"loginPassword\">Password</label>\n            <input type=\"password\" id=\"loginPassword\" placeholder=\"••••••••\" required minlength=\"6\">\n            <span class=\"error-msg\" id=\"loginPasswordError\"></span>\n          </div>\n          <button type=\"submit\" class=\"btn btn--primary btn--full\">Sign In</button>\n          <p class=\"auth-switch\">Don't have an account? <a href=\"#\" id=\"switchToRegister\">Register</a></p>\n        </form>\n\n        <!-- فرم ثبت‌نام -->\n        <form class=\"auth-form\" id=\"registerForm\" novalidate>\n          <h2 class=\"auth-title\">Create Account</h2>\n          <div class=\"form-group\">\n            <label for=\"regName\">Full Name</label>\n            <input type=\"text\" id=\"regName\" placeholder=\"John Doe\" required minlength=\"2\">\n            <span class=\"error-msg\" id=\"regNameError\"></span>\n          </div>\n          <div class=\"form-group\">\n            <label for=\"regEmail\">Email</label>\n            <input type=\"email\" id=\"regEmail\" placeholder=\"your@email.com\" required>\n            <span class=\"error-msg\" id=\"regEmailError\"></span>\n          </div>\n          <div class=\"form-group\">\n            <label for=\"regPassword\">Password</label>\n            <input type=\"password\" id=\"regPassword\" placeholder=\"Min 6 chars, 1 number & 1 uppercase\" required>\n            <span class=\"error-msg\" id=\"regPasswordError\"></span>\n          </div>\n          <div class=\"form-group\">\n            <label for=\"regConfirm\">Confirm Password</label>\n            <input type=\"password\" id=\"regConfirm\" placeholder=\"Re-enter password\" required>\n            <span class=\"error-msg\" id=\"regConfirmError\"></span>\n          </div>\n          <button type=\"submit\" class=\"btn btn--primary btn--full\">Register</button>\n          <p class=\"auth-switch\">Already have an account? <a href=\"#\" id=\"switchToLogin\">Login</a></p>\n        </form>\n      </div>\n\n      <!-- پیغام خطا/موفقیت (۴ ثانیه) -->\n      <div class=\"toast-message\" id=\"toastMessage\"></div>\n    </section>\n  </main>\n@endsection",
  "resources/views/cart.blade.php": "@extends('layouts.master')\n\n@section('title')\n  Cart\n@endsection\n@section('scripts')\n  <script src={{ asset(\"js/cart.js\") }}></script>\n@endsection\n@section('styles')\n  <link rel=\"stylesheet\" href={{ asset(\"css/cart.css\") }}>\n@endsection\n\n\n@section('body')\n  <main>\n    <!-- ===== CART SECTION ===== -->\n    <section class=\"cart-section container\">\n      <h1 class=\"cart-title\">🛒 Your Shopping Cart</h1>\n\n      <div class=\"cart-wrapper\">\n        <!-- لیست سبد خرید -->\n        <div class=\"cart-items\" id=\"cartItems\">\n          <!-- توسط JS پر می‌شود -->\n        </div>\n\n        <!-- خلاصه سبد -->\n        <aside class=\"cart-summary\" id=\"cartSummary\">\n          <h3 class=\"summary-title\">Order Summary</h3>\n          <div class=\"summary-row\">\n            <span>Subtotal</span>\n            <span id=\"subtotal\">$0.00</span>\n          </div>\n          <div class=\"summary-row\">\n            <span>Shipping</span>\n            <span id=\"shipping\">$0.00</span>\n          </div>\n          <div class=\"summary-row total\">\n            <span>Total</span>\n            <span id=\"totalPrice\">$0.00</span>\n          </div>\n          <button class=\"btn btn--primary btn--full\" id=\"checkoutBtn\">Proceed to Checkout</button>\n          <a href=\"index.html\" class=\"btn btn--secondary btn--full\">Continue Shopping</a>\n        </aside>\n      </div>\n\n      <!-- سبد خالی -->\n      <div class=\"empty-cart\" id=\"emptyCart\" style=\"display:none;\">\n        <span class=\"empty-icon\">🛒</span>\n        <h2>Your cart is empty</h2>\n        <p>Looks like you haven't added any items yet.</p>\n        <a href=\"index.html\" class=\"btn btn--primary\">Start Shopping</a>\n      </div>\n    </section>\n  </main>\n@endsection",
