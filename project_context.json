  "resources/views/product.blade.php": "@extends('layouts.master')\n\n@section('title', $product->name . ' - Product Details')\n\n@section('styles')\n  <link rel=\"stylesheet\" href=\"{{ asset('css/product.css') }}\">\n@endsection\n\n@section('scripts')\n  <script src=\"{{ asset('js/cart.js') }}\"></script>\n  <script src=\"{{ asset('js/product.js') }}\"></script>\n@endsection\n\n@section('body')\n  @php\n    $firstImage = $product->images->first();\n  @endphp\n\n  <main>\n    <section\n      class=\"product-detail container\"\n      id=\"productDetail\"\n      data-product-id=\"{{ $product->id }}\"\n      data-product-name=\"{{ $product->name }}\"\n      data-product-price=\"{{ $product->price }}\"\n      data-product-image=\"{{ $firstImage ? asset($firstImage->name) : '' }}\"\n    >\n      <div class=\"product-detail__wrapper\">\n        {{-- ===== گالری ===== --}}\n        <div class=\"product-detail__gallery\">\n          <div class=\"product-detail__main-image\" id=\"mainImage\">\n            @if ($firstImage)\n              <img\n                class=\"product-detail__image\"\n                src=\"{{ asset($firstImage->name) }}\"\n                alt=\"{{ $product->name }}\"\n              >\n            @else\n              <div class=\"product-detail__image product-detail__image--placeholder\">\n                No Image\n              </div>\n            @endif\n          </div>\n\n          @if ($product->images->count() > 1)\n            <div class=\"product-detail__thumbnails\" id=\"thumbnails\">\n              @foreach ($product->images as $index => $image)\n                <div\n                  class=\"product-detail__thumb {{ $index === 0 ? 'active' : '' }}\"\n                  data-src=\"{{ asset($image->name) }}\"\n                >\n                  <img src=\"{{ asset($image->name) }}\" alt=\"{{ $product->name }} #{{ $index + 1 }}\">\n                </div>\n              @endforeach\n            </div>\n          @endif\n        </div>\n\n        {{-- ===== اطلاعات محصول ===== --}}\n        <div class=\"product-detail__info\">\n          <h1 class=\"product-detail__name\" id=\"productName\">{{ $product->name }}</h1>\n\n          <div class=\"product-detail__rating\">\n            <span class=\"stars\">★★★★★</span>\n            <span class=\"reviews\">\n              ({{ $product->comments->where('is_showable', true)->count() }} reviews)\n            </span>\n          </div>\n\n          <div class=\"product-detail__price\" id=\"productPrice\">\n            ${{ number_format($product->price, 2) }}\n          </div>\n\n          <div class=\"product-detail__description\" id=\"productDesc\">\n            <p>{{ $product->description }}</p>\n          </div>\n\n          <div class=\"product-detail__meta\">\n            <div class=\"meta-item\">\n              <span class=\"meta-label\">Category:</span>\n              <span class=\"meta-value\">\n                {{ $product->categories->pluck('name')->join(', ') ?: '—' }}\n              </span>\n            </div>\n            <div class=\"meta-item\">\n              <span class=\"meta-label\">SKU:</span>\n              <span class=\"meta-value\">#{{ str_pad($product->id, 4, '0', STR_PAD_LEFT) }}</span>\n            </div>\n            <div class=\"meta-item\">\n              <span class=\"meta-label\">Stock:</span>\n              <span class=\"meta-value\">\n                {{ $product->stock > 0 ? 'In Stock (' . (int) $product->stock . ')' : 'Out of Stock' }}\n              </span>\n            </div>\n          </div>\n\n          <div class=\"product-detail__actions\">\n            <div class=\"qty-selector\">\n              <button class=\"qty-btn\" id=\"qtyDecrease\" type=\"button\">−</button>\n              <span class=\"qty-value\" id=\"qtyValue\">1</span>\n              <button class=\"qty-btn\" id=\"qtyIncrease\" type=\"button\">+</button>\n            </div>\n\n            <button\n              class=\"btn btn--primary add-to-cart-btn\"\n              id=\"addToCartBtn\"\n              type=\"button\"\n              {{ $product->stock <= 0 ? 'disabled' : '' }}\n            >\n              {{ $product->stock > 0 ? 'Add to Cart' : 'Out of Stock' }}\n            </button>\n\n            <button class=\"btn btn--secondary wishlist-btn\" id=\"wishlistBtn\" type=\"button\">\n              ♡ Wishlist\n            </button>\n          </div>\n\n          <div class=\"product-detail__shipping\">\n            <span>🚚 Free shipping on orders over $50</span>\n            <span>↩️ 30-day return policy</span>\n          </div>\n        </div>\n      </div>\n\n      {{-- ===== محصولات مرتبط ===== --}}\n      @if (isset($related) && $related->isNotEmpty())\n        <section class=\"related-products\">\n          <h2 class=\"section-title\">✨ You May Also Like</h2>\n          <div class=\"products__grid\" id=\"relatedGrid\">\n            @foreach ($related as $item)\n              @php $thumb = $item->images->first(); @endphp\n              <div class=\"product-card\">\n                @if ($thumb)\n                  <img class=\"product-card__emoji\" src=\"{{ asset($thumb->name) }}\" alt=\"{{ $item->name }}\">\n                @endif\n                <h3 class=\"product-card__name\">{{ $item->name }}</h3>\n                <div class=\"product-card__price\">${{ number_format($item->price, 2) }}</div>\n                <a class=\"product-card__btn\" href=\"{{ route('product', $item->id) }}\">View Product</a>\n              </div>\n            @endforeach\n          </div>\n        </section>\n      @endif\n    </section>\n  </main>\n@endsection",
