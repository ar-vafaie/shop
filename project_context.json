  "storage/framework/views/e26d1ce592b056ae006f57f94cefba6f.php": "<?php $__env->startSection('title', $product->name . ' - Product Details'); ?>\n\n<?php $__env->startSection('styles'); ?>\n  <link rel=\"stylesheet\" href=\"<?php echo e(asset('css/product.css')); ?>\">\n<?php $__env->stopSection(); ?>\n\n<?php $__env->startSection('scripts'); ?>\n  <script src=\"<?php echo e(asset('js/cart.js')); ?>\"></script>\n  <script src=\"<?php echo e(asset('js/product.js')); ?>\"></script>\n<?php $__env->stopSection(); ?>\n\n<?php $__env->startSection('body'); ?>\n  <?php\n    $firstImage = $product->images->first();\n  ?>\n\n  <main>\n    <section\n      class=\"product-detail container\"\n      id=\"productDetail\"\n      data-product-id=\"<?php echo e($product->id); ?>\"\n      data-product-name=\"<?php echo e($product->name); ?>\"\n      data-product-price=\"<?php echo e($product->price); ?>\"\n      data-product-image=\"<?php echo e($firstImage ? asset($firstImage->name) : ''); ?>\"\n    >\n      <div class=\"product-detail__wrapper\">\n        \n        <div class=\"product-detail__gallery\">\n          <div class=\"product-detail__main-image\" id=\"mainImage\">\n            <?php if($firstImage): ?>\n              <img\n                class=\"product-detail__image\"\n                src=\"<?php echo e(asset($firstImage->name)); ?>\"\n                alt=\"<?php echo e($product->name); ?>\"\n              >\n            <?php else: ?>\n              <div class=\"product-detail__image product-detail__image--placeholder\">\n                No Image\n              </div>\n            <?php endif; ?>\n          </div>\n\n          <?php if($product->images->count() > 1): ?>\n            <div class=\"product-detail__thumbnails\" id=\"thumbnails\">\n              <?php $__currentLoopData = $product->images; $__env->addLoop($__currentLoopData); foreach($__currentLoopData as $index => $image): $__env->incrementLoopIndices(); $loop = $__env->getLastLoop(); ?>\n                